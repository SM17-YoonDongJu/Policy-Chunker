# EC2 호스트의 ~/insurance-chunker/.env.prod 템플릿.
# 이 파일을 .env.prod로 복사해 실제 값으로 채운다(.env.prod는 커밋 금지 — .gitignore 처리됨).
# docker-compose.prod.yml이 env_file로 읽는다.

# 배포 파이프라인이 SSM 셸에서 export하지만, 수동 실행(docker compose run) 시엔 여기 값이 쓰인다.
AWS_ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=main

# --- pgvector DB (필수) ---
DATABASE_URL=postgresql://user:password@db-host:5432/insurance

# --- 임베딩 (Ollama 기본) ---
EMBED_BACKEND=ollama
# network_mode: host 이므로 호스트에 뜬 ollama에 localhost로 접속한다.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

# --- 검색 (파트너 계약) ---
SEARCH_RERANK=1

# --- VLM (선택; 컨테이너에 claude CLI 없음 → 기본 비활성) ---
# VLM_BACKEND=claude
# CLAUDE_BIN=claude
# VLM_DPI=150
# VLM_TIMEOUT=300
# VISION_MAX_PAGES=9999
