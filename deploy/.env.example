# 로컬 개발용 .env 템플릿 (.env는 커밋 금지 — .gitignore 처리됨).
#
# ── 운영 값은 여기 없다 ─────────────────────────────────────────────────────
# 운영은 brbs-etl 노드의 Deployment로 돌고, 환경변수의 진실원은 K8s-manifests의
# charts/etl-chunker/templates/deployment.yaml이다. 이 파일은 그 값들이 각각 무엇을
# 뜻하는지 적어둔 참고 문서 겸 로컬 템플릿이다 — 여기를 고쳐도 운영은 바뀌지 않는다.
#
# 비밀값은 DATABASE_URL 하나뿐이고, AWS Secrets Manager의 app/insurance-chunker-dev에
# 두고 External Secrets Operator가 Secret으로 만든다. 레포에는 "어떤 키를 가져올지"만 있다.
#
#   aws secretsmanager put-secret-value --secret-id app/insurance-chunker-dev \
#     --secret-string '{"DATABASE_URL":"postgresql://..."}'
#
# 값을 바꿔도 파드는 자동 재시작되지 않는다 — kubectl rollout restart까지 해야 한다.
# S3·Secrets Manager 접근은 노드 IAM 역할로 한다(AWS 키를 넣지 않는다).

# --- pgvector DB (필수) ---
# DSN 끝의 options=-csearch_path%3Dcorpus,public 은 필수다. 두 스키마가 모두 있어야 한다.
#   corpus — db/*.py의 SQL은 테이블명을 스키마 없이 쓴다(policy_chunks, search_terms). 운영 RDS의
#     실체는 SM17-YoonDongJu/AI 레포가 migrations/corpus/로 만든 corpus.policy_chunks다. 이게 빠지면
#     public.policy_chunks라는 별개 빈 테이블이 생겨 우리는 거기에 적재하고 AI 레포 RAG는 corpus.*를
#     읽어 검색 결과가 0건이 된다(에러 없이 조용히 어긋남).
#   public — vector 확장이 public에 설치돼 있어 halfvec 타입이 거기 산다. 빼면 schema.sql이
#     'type "halfvec" does not exist'로 실패한다(로컬 pgvector로 실측 확인).
# 접속 계정은 corpus_owner여야 한다. ingest는 매 실행 init_schema()로 DDL을 돌리는데, Postgres는
# IF NOT EXISTS가 있어도 소유권 검사를 존재 검사보다 먼저 하므로 비소유자면 권한 오류로 죽는다.
#   (AI 레포 migrations/README.md의 #48~#52 사건 참고)
DATABASE_URL=postgresql://corpus_owner:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres?options=-csearch_path%3Dcorpus,public

# corpus.* 테이블의 DDL은 AI 레포 migrations/corpus/가 단일 관리한다. 우리 db/schema.sql은
# 로컬 개발용으로만 남기고 운영에서는 실행하지 않는다(진실원 이중화 → 드리프트 방지).
# 이 값을 지우면 ingest가 매 실행 CREATE/ALTER를 운영 테이블에 돌린다.
SKIP_INIT_SCHEMA=1

# --- 임베딩 (Ollama 기본) ---
EMBED_BACKEND=ollama
# 로컬 개발 기본값. 운영은 차트가 클러스터 Service를 넣는다(http://ollama:11434).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# 배치가 클수록 HTTP 왕복이 줄어 GPU가 연속으로 일한다. 다만 상한은 GPU 전력이다 —
# T4 실측에서 임베딩 부하가 이미 70W 캡을 넘겨 부스트 클럭이 1590→1200MHz로 깎인다.
# 32 → 64 → 128을 재보고 개선이 멈추는 지점을 쓴다. 키우면 타임아웃도 같이 올릴 것.
# EMBED_BATCH_SIZE=32
# EMBED_BATCH_TIMEOUT=120
# 장문 절단 상한. eval/retrieval_eval.py와 같은 값이어야 평가 수치가 재현된다.
# EMBED_MAX_CHARS=1800

# --- 검색 (파트너 계약) ---
SEARCH_RERANK=1

# --- 코퍼스 소스 (S3 + ai.corpus_file 카탈로그) ---
# corpus_worker(AI 레포)가 Notion→S3로 스테이징한 약관을 받아온다. corpus EC2의
# /opt/corpus/.env.corpus와 같은 버킷을 쓴다(corpus/ prefix로 분리).
S3_BUCKET=REPLACE_ME
AWS_REGION=ap-northeast-2

# --- 인덱싱 데몬 (worker.py) ---
# catalog(기본) = ai.corpus_file + S3 / manifest = 손으로 쓴 /data/docs.yaml
INGEST_SOURCE=catalog
# 주기(초). 기본 604800=7일. 운영 값은 차트에 있고, 바꾸려면 차트를 고쳐 재배포한다
# (이미지 재빌드는 불필요).
INGEST_INTERVAL_SECONDS=604800
# 매니페스트 경로(컨테이너 기준). 운영에서는 /data에 chunker-state PVC가 마운트된다.
MANIFEST_PATH=/data/docs.yaml
# 기동 즉시 1회 실행. 0으로 두면 첫 주기까지 기다린다.
RUN_ON_START=1

# --- 운영 계측 (runlog / healthcheck / 알림) ---
# 실행 이력 디렉터리. 운영에서 /data는 chunker-state PVC라 파드를 다시 만들어도 남는다.
# 쓰기가 안 되면 컨테이너 안 ./.state로 폴백하며 경고를 남긴다(그땐 이력이 함께 사라진다).
# 증분 처리(SKIPPED 판정)의 근거라, 유실되면 다음 주기가 전체 재적재가 된다.
INGEST_STATE_DIR=/data/state
# 0청크·오류가 이 횟수만큼 연속되면 문서를 격리해 다운로드·파싱조차 건너뛴다.
# (0청크 문서는 DB에 행이 안 생겨 멱등 스킵이 안 걸리므로 상한이 없으면 매 주기 재처리된다)
INGEST_MAX_RETRY=3
# 문서를 동시에 몇 개 처리할지. 기본 1 = 기존 순차 동작.
# parse가 전체의 47.7%이고 CPU 바운드라 문서를 겹치면 A가 임베딩을 기다리는 동안 B를
# 파싱한다. 다만 brbs-etl 노드는 vCPU가 4개이고 corpus-worker·ollama·vLLM 파드와 나눠 쓴다 — 2가
# 현실적이고 3부터는 재보고 정해야 한다. embed 쪽은 GPU가 큐잉하므로 비례해서 빨라지지 않는다.
# INGEST_CONCURRENCY=1
# healthcheck 허용 배수 — 마지막 성공이 주기 x 이 값보다 오래됐으면 unhealthy.
HEALTH_GRACE_FACTOR=1.5
# 사이클 결과 Discord 웹훅. 비우면 알림만 건너뛴다(인덱싱은 정상 동작).
# CI/배포 알림과 다른 채널을 쓰고 싶으면 여기만 바꾸면 된다.
DISCORD_WEBHOOK_INGEST=
# always = 매 사이클 알림 / failure = 실패·경고일 때만
INGEST_NOTIFY=always

# --- 관측 (Prometheus) ---
# 차트가 9101을 준다. 여기서 덮으면 Service·ServiceMonitor의 포트도 같이 바꿔야 한다.
# METRICS_PORT=9101

# --- 인덱스 SLO 점검 (slo.py — 매 사이클 끝에 실행) ---
# max(ingested_at) 허용 경과일. 기본은 주기 x 1.5.
# SLO_MAX_STALE_DAYS=10.5
# 카탈로그 대비 적재 문서 비율 하한. 0이면 검사 안 함(ai 스키마 권한 없을 때).
# SLO_MIN_COVERAGE=0.8

# --- 로깅 ---
# json | text. 차트가 json으로 주므로 여기선 보통 건드릴 일이 없다.
# Alloy가 JSON을 파싱해 level을 Loki 라벨로 승격한다 — 평문이면 그 단계가 안 먹는다.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# --- VLM 표 추출 ---
# 괘선이 없거나 이미지로 박힌 표는 PyMuPDF/pdfplumber로 못 뽑는다. VLM_TARGET=gap(기본)이
# 그런 페이지를 골라 VLM에 보낸다 — 텍스트 레이어가 없는 쪽을 먼저 쓴다.
#
# 예전 기본값은 반대였다(PyMuPDF가 표를 '찾은' 페이지에만 VLM). 그러면 이미 잘 되던
# 추출을 덮어쓸 기회만 생긴다 — 실측에서 ICD-10 코드표가 그렇게 망가졌다(I00~I02 →
# 100~102). 되돌리려면 VLM_TARGET=tables.
# 기본값은 운영 조합이다. 운영은 차트가 vLLM Service 주소를 넣는다.
#   운영  VLM_BACKEND=local  VLM_URL=http://vllm:8000  VLM_MODEL=PaddleOCR-VL-1.6-0.9B
# vLLM의 --served-model-name과 VLM_MODEL이 같아야 한다 — 다르면 모르는 모델이라고 거절당한다.
# 로컬은 같은 모델을 vLLM이나 llama-server(PaddleOCR-VL GGUF)로 띄우고 VLM_URL을 그 포트로
# 맞춘다. Ollama에 받아 둔 범용 VLM을 쓸 거면 VLM_MODEL에 그 이름을 주면 프롬프트가 따라 바뀐다.
#
# 끄려면:
# VLM_BACKEND=off
#
# VLM_DPI=150
# VLM_TIMEOUT=300                # 읽기 타임아웃. GPU 경로 실측이 페이지당 21~36초다
# VLM_CONNECT_TIMEOUT=5          # 접속은 즉시여야 한다 — 서버가 없으면 밀리초 안에 실패
# VLM_FAIL_STREAK=3              # 연속 N회 실패하면 그 문서의 남은 페이지는 건너뛴다
# VLM_TARGET=gap                 # gap | tables | both
# VLM_HINT_DRAWINGS=25           # gap 2순위: 괘선이 이만큼이면 표로 본다
# VLM_HINT_MIN_TEXT=200          # gap 1순위: 텍스트가 이보다 적고
# VLM_HINT_IMG_FRAC=0.25         #            이미지가 이만큼 덮으면 OCR이 빈 스캔 페이지
# VISION_MAX_PAGES=50           # 문서당 VLM 호출 상한. 50 x 25초 = 약 20분이 상한이 된다.
#                                넘는 페이지는 VLM만 건너뛰고 PyMuPDF/pdfplumber 결과를 쓴다
#
# 알아둘 것:
#   · 운영에서 임베딩과 VLM은 서버가 다르다 — 임베딩은 ollama, VLM은 vLLM이다. 둘이
#     time-slicing으로 T4 한 장을 나눠 쓰고 VRAM은 격리되지 않으므로, vLLM에
#     --gpu-memory-utilization 0.85를 걸어 ollama 몫을 남겨뒀다. 모델 교체(축출) 경합은
#     없다 — ollama가 이제 임베딩 모델 하나만 들고 있다.
#   · VLM은 표 탐지 페이지마다 1회 호출이라 문서당 처리 시간이 눈에 띄게 늘어난다.
#     VISION_MAX_PAGES로 상한을 걸 수 있다.
#   · 서버가 GPU를 못 잡고 CPU로 떨어지면 페이지당 600초로도 안 끝난다. 그때
#     VLM_FAIL_STREAK가 문서 단위로 접는다 — 없을 때 214페이지 문서 하나로
#     35.6시간을 태운 적이 있다. 그 장애 기록은 deploy/ollama/README.md 참고.
#
# llama-server(PaddleOCR-VL)로 되돌리려면 VLM_MODEL을 비우고
#   VLM_PROMPT="Table Recognition:" 로 바꾼다.
# surya를 쓰려면 이미지에 [ocr] extra를 넣어야 한다.
