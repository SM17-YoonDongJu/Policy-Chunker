# EC2 호스트의 ~/insurance-chunker/.env 템플릿.
# 이 파일을 .env로 복사해 실제 값으로 채운다(.env는 커밋 금지 — .gitignore 처리됨).
# docker-compose.prod.yml이 env_file로 읽는다.

# 배포 파이프라인이 SSM 셸에서 export하지만, 수동 실행(docker compose run) 시엔 여기 값이 쓰인다.
AWS_ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=latest

# --- pgvector DB (필수) ---
# DSN 끝의 options=-csearch_path%3Dcorpus,public 은 필수다. 두 스키마가 모두 있어야 한다.
#   corpus — db/*.py의 SQL은 테이블명을 스키마 없이 쓴다(policy_chunks, search_terms). 운영 RDS의
#     실체는 SM17-YoonDongJu/AI 레포가 migrations/corpus/로 만든 corpus.policy_chunks다. 이게 빠지면
#     public.policy_chunks라는 별개 빈 테이블이 생겨 우리는 거기에 적재하고 AI 레포 RAG는 corpus.*를
#     읽어 검색 결과가 0건이 된다(에러 없이 조용히 어긋남).
#   public — vector 확장이 public에 설치돼 있어 halfvec 타입이 거기 산다. 빼면 schema.sql이
#     'type "halfvec" does not exist'로 실패한다(로컬 pgvector로 실측 확인).
# 접속 계정은 corpus_owner여야 한다. ingest는 매 실행 init_schema()로 DDL을 돌리는데, Postgres는
# IF NOT EXISTS가 있어도 소유권 검사를 존재 검사보다 먼저 하므로 비소유자면 권한 오류로 죽는다.
#   (AI 레포 migrations/README.md의 #48~#52 사건 참고)
DATABASE_URL=postgresql://corpus_owner:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres?options=-csearch_path%3Dcorpus,public

# corpus.* 테이블의 DDL은 AI 레포 migrations/corpus/가 단일 관리한다. 우리 db/schema.sql은
# 로컬 개발용으로만 남기고 운영에서는 실행하지 않는다(진실원 이중화 → 드리프트 방지).
# 이 값을 지우면 ingest가 매 실행 CREATE/ALTER를 운영 테이블에 돌린다.
SKIP_INIT_SCHEMA=1

# --- 임베딩 (Ollama 기본) ---
EMBED_BACKEND=ollama
# network_mode: host 이므로 호스트에 뜬 ollama에 localhost로 접속한다.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

# --- 검색 (파트너 계약) ---
SEARCH_RERANK=1

# --- VLM (선택; 컨테이너에 claude CLI 없음 → 기본 비활성) ---
# VLM_BACKEND=claude
# CLAUDE_BIN=claude
# VLM_DPI=150
# VLM_TIMEOUT=300
# VISION_MAX_PAGES=9999
