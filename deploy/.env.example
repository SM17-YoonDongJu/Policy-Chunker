# EC2 호스트의 ~/insurance-chunker/.env 템플릿.
# 이 파일을 .env로 복사해 실제 값으로 채운다(.env는 커밋 금지 — .gitignore 처리됨).
# docker-compose.prod.yml이 env_file로 읽는다.

# 배포 파이프라인이 SSM 셸에서 export하지만, 수동 실행(docker compose run) 시엔 여기 값이 쓰인다.
AWS_ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=latest

# --- pgvector DB (필수) ---
# DSN 끝의 options=-csearch_path%3Dcorpus,public 은 필수다. 두 스키마가 모두 있어야 한다.
#   corpus — db/*.py의 SQL은 테이블명을 스키마 없이 쓴다(policy_chunks, search_terms). 운영 RDS의
#     실체는 SM17-YoonDongJu/AI 레포가 migrations/corpus/로 만든 corpus.policy_chunks다. 이게 빠지면
#     public.policy_chunks라는 별개 빈 테이블이 생겨 우리는 거기에 적재하고 AI 레포 RAG는 corpus.*를
#     읽어 검색 결과가 0건이 된다(에러 없이 조용히 어긋남).
#   public — vector 확장이 public에 설치돼 있어 halfvec 타입이 거기 산다. 빼면 schema.sql이
#     'type "halfvec" does not exist'로 실패한다(로컬 pgvector로 실측 확인).
# 접속 계정은 corpus_owner여야 한다. ingest는 매 실행 init_schema()로 DDL을 돌리는데, Postgres는
# IF NOT EXISTS가 있어도 소유권 검사를 존재 검사보다 먼저 하므로 비소유자면 권한 오류로 죽는다.
#   (AI 레포 migrations/README.md의 #48~#52 사건 참고)
DATABASE_URL=postgresql://corpus_owner:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres?options=-csearch_path%3Dcorpus,public

# corpus.* 테이블의 DDL은 AI 레포 migrations/corpus/가 단일 관리한다. 우리 db/schema.sql은
# 로컬 개발용으로만 남기고 운영에서는 실행하지 않는다(진실원 이중화 → 드리프트 방지).
# 이 값을 지우면 ingest가 매 실행 CREATE/ALTER를 운영 테이블에 돌린다.
SKIP_INIT_SCHEMA=1

# --- 임베딩 (Ollama 기본) ---
EMBED_BACKEND=ollama
# network_mode: host 이므로 호스트에 뜬 ollama에 localhost로 접속한다.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# 배치가 클수록 HTTP 왕복이 줄어 GPU가 연속으로 일한다. 다만 상한은 GPU 전력이다 —
# T4 실측에서 임베딩 부하가 이미 70W 캡을 넘겨 부스트 클럭이 1590→1200MHz로 깎인다.
# 32 → 64 → 128을 재보고 개선이 멈추는 지점을 쓴다. 키우면 타임아웃도 같이 올릴 것.
# EMBED_BATCH_SIZE=32
# EMBED_BATCH_TIMEOUT=120
# 장문 절단 상한. eval/retrieval_eval.py와 같은 값이어야 평가 수치가 재현된다.
# EMBED_MAX_CHARS=1800

# --- 검색 (파트너 계약) ---
SEARCH_RERANK=1

# --- 코퍼스 소스 (S3 + ai.corpus_file 카탈로그) ---
# corpus_worker(AI 레포)가 Notion→S3로 스테이징한 약관을 받아온다. corpus EC2의
# /opt/corpus/.env.corpus와 같은 버킷을 쓴다(corpus/ prefix로 분리).
S3_BUCKET=REPLACE_ME
AWS_REGION=ap-northeast-2

# --- 인덱싱 데몬 (worker.py) ---
# catalog(기본) = ai.corpus_file + S3 / manifest = 손으로 쓴 /data/docs.yaml
INGEST_SOURCE=catalog
# 주기(초). 기본 604800=7일. 값을 바꾸면 재기동만 하면 된다(이미지 재빌드 불필요):
#   docker compose up -d --force-recreate chunker
INGEST_INTERVAL_SECONDS=604800
# 매니페스트 경로(컨테이너 기준). 호스트 ./data가 /data로 마운트된다.
MANIFEST_PATH=/data/docs.yaml
# 기동 즉시 1회 실행. 0으로 두면 첫 주기까지 기다린다.
RUN_ON_START=1

# --- 운영 계측 (runlog / healthcheck / 알림) ---
# 실행 이력 디렉터리. /data는 호스트 ./data 볼륨이라 컨테이너를 다시 만들어도 남는다.
# 쓰기가 안 되면 컨테이너 안 ./.state로 폴백하며 경고를 남긴다(그땐 이력이 함께 사라진다).
INGEST_STATE_DIR=/data/state
# 0청크·오류가 이 횟수만큼 연속되면 문서를 격리해 다운로드·파싱조차 건너뛴다.
# (0청크 문서는 DB에 행이 안 생겨 멱등 스킵이 안 걸리므로 상한이 없으면 매 주기 재처리된다)
INGEST_MAX_RETRY=3
# healthcheck 허용 배수 — 마지막 성공이 주기 x 이 값보다 오래됐으면 unhealthy.
HEALTH_GRACE_FACTOR=1.5
# 사이클 결과 Discord 웹훅. 비우면 알림만 건너뛴다(인덱싱은 정상 동작).
# CI/배포 알림과 다른 채널을 쓰고 싶으면 여기만 바꾸면 된다.
DISCORD_WEBHOOK_INGEST=
# always = 매 사이클 알림 / failure = 실패·경고일 때만
INGEST_NOTIFY=always

# --- 관측 (Prometheus) ---
# compose가 9101을 준다. 여기서 덮으면 스크랩 잡의 포트도 같이 바꿔야 한다.
# METRICS_PORT=9101

# --- 로깅 ---
# json | text. compose가 json으로 주므로 여기선 보통 건드릴 일이 없다.
# Alloy가 JSON을 파싱해 level을 Loki 라벨로 승격한다 — 평문이면 그 단계가 안 먹는다.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# --- VLM (선택; 컨테이너에 claude CLI 없음 → 기본 비활성) ---
# VLM_BACKEND=claude
# CLAUDE_BIN=claude
# VLM_DPI=150
# VLM_TIMEOUT=300
# VISION_MAX_PAGES=9999
